# Raspberry Pi ports (original field defaults)
USV_X8R_PORT=/dev/ttyAMA0
USV_TELEMETRY_PORT=/dev/ttyUSB0
USV_ARDUINO_PORT=/dev/ttyUSB1

# Link speeds
USV_X8R_BAUD=100000
USV_TELEMETRY_BAUD=57600
USV_ARDUINO_BAUD=9600

# Keep N/1 when using the proven field adapter. Standard SBUS adapters may need E/2.
USV_X8R_PARITY=N
USV_X8R_STOPBITS=1

# Control safety and mode selection
USV_RC_THRESHOLD=1700
USV_COMPUTER_THRESHOLD=1300
USV_DEAD_ZONE=50
USV_SBUS_TIMEOUT=0.5
USV_AUTO_DETECT_USB=true

# Ground station
USV_GROUND_PORT=/dev/tty.usbserial-0001
USV_GROUND_BAUD=57600
USV_GROUND_TIMEOUT=0.1
USV_DATA_FILE=all_sensors.xlsx
USV_FLUSH_EVERY=1
USV_KEYBOARD_ENABLED=true
